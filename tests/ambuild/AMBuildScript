import os

SdkHelpers = builder.Eval(os.path.join(builder.sourcePath, '..', '..', 'SdkHelpers.ambuild'))
if builder.options.s2sdk:
  SdkHelpers.find_sdk_path = lambda name: builder.options.s2sdk

cxx = builder.DetectCxx(target_arch = 'x86_64')
SdkHelpers.findSdks(builder, [cxx], [builder.options.sdk])

for sdk_target in SdkHelpers.sdk_targets:
  sdk = sdk_target.sdk
  binary = sdk_target.cxx.Library('s2sdk_manifests_test')
  binary.sources += [os.path.join(builder.sourcePath, '..', 'cmake', 'main.cpp')]
  if binary.compiler.target.platform == 'linux':
    binary.compiler.cflags += ['-fPIC']
  else:
    binary.compiler.cflags += ['/MT', '/EHsc']
  SdkHelpers.configureCxx(builder, binary, sdk)
  binary.custom = [builder.tools.Protoc(protoc = sdk_target.protoc, sources = [
    os.path.join(sdk['path'], 'common', 'valveextensions.proto'),
    os.path.join(sdk['path'], 'common', 'network_connection.proto'),
    os.path.join(sdk['path'], 'common', 'networkbasetypes.proto'),
  ])]
  builder.Add(binary)
