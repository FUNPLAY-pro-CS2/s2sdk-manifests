{
    "name": "dota",
    "branch": "dota",
    "env_vars": ["S2SDK_DOTA", "S2SDKDOTA", "HL2SDK_DOTA", "HL2SDKDOTA"],
    "env_var": "HL2SDKDOTA",
    "extension": "2.dota",
    "code": 24,
    "define": "DOTA",
    "platforms": {
        "windows": [
            "x86_64"
        ],
        "linux": [
            "x86_64"
        ]
    },
    "source2": true,
    "cxx_standard": 20,
    "include_paths": [
        "thirdparty/protobuf-3.21.8/src",
        "public",
        "public/mathlib",
        "public/tier0",
        "public/tier1",
        "public/entity2",
        "game/shared",
        "common"
    ],
    "defines": [
        "GAME_DLL",
        "RAD_TELEMETRY_DISABLED",
        "X64BITS",
        "PLATFORM_64BITS"
    ],
    "linux": {
        "x86_64": {
            "postlink_libs": [
                "lib/linux64/mathlib.a",
                "lib/linux64/interfaces.a",
                "lib/linux64/release/libprotobuf.a"
            ],
            "dynamic_libs": [
                "lib/linux64/libtier0.so",
                "lib/linux64/libsteam_api.so"
            ]
        },
        "defines": [
            "COMPILER_GCC",
            "_LINUX",
            "LINUX",
            "POSIX",
            "GNUC",
            "_GLIBCXX_USE_CXX11_ABI=0",
            "_finite=finite",
            "stricmp=strcasecmp",
            "_stricmp=strcasecmp",
            "strnicmp=strncasecmp",
            "_strnicmp=strncasecmp",
            "strcmpi=strcasecmp",
            "_vsnprintf=vsnprintf",
            "_alloca=alloca"
        ],
        "linkflags": [
            "-lm"
        ],
        "uses_system_cxxlib": false,
        "protoc_path": "devtools/bin/linux/protoc"
    },
    "windows": {
        "x86_64": {
            "libs": [
                "lib/public/win64/2015/libprotobuf.lib",
                "lib/public/win64/mathlib.lib",
                "lib/public/win64/tier0.lib",
                "lib/public/win64/interfaces.lib",
                "lib/public/win64/steam_api64.lib"
            ]
        },
        "defines": [
            "COMPILER_MSVC",
            "COMPILER_MSVC64",
            "WIN32",
            "WIN64",
            "_ITERATOR_DEBUG_LEVEL=0"
        ],
        "linkflags": [
            "legacy_stdio_definitions.lib"
        ],
        "protoc_path": "devtools/bin/protoc.exe"
    }
}
