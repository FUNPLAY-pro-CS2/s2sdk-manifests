            "libs": [
                "lib/public/win64/2015/libprotobuf.lib",
                "lib/public/win64/mathlib.lib",
                "lib/public/win64/tier0.lib",
                "lib/public/win64/interfaces.lib",
                "lib/public/win64/steam_api64.lib"
