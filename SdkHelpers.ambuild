# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# AMBuild entry point, with the interface of hl2sdk-manifests' SdkHelpers
# (findSdks, sdks, sdk_targets, configureCxx, SdkTarget.protoc).
#
# manifests/<game>.json has what differs per game. What a binary needs from the
# SDK is the same for every game and comes from makefiles/ambuild/:
# shared.ambuild <-> shared.cmake, linux.ambuild <-> linux.cmake,
# windows.ambuild <-> windows.cmake, protobufs.ambuild <-> protobufs.cmake --
# the AMBuild twins of makefiles/cmake/,
# which s2sdk-manifests.cmake loads for CMake builds.
import importlib.util
import json
import os
import sys

def get_this_file_path():
  return get_this_file_path.__code__.co_filename

try:
  # Requires new enough ambuild version for __file__ to be defined
  ROOT = os.path.dirname(os.path.abspath(__file__))
except NameError:
  ROOT = os.path.dirname(os.path.abspath(get_this_file_path()))

def Load(name):
  path = os.path.join(ROOT, 'makefiles', 'ambuild', name + '.ambuild')
  spec = importlib.util.spec_from_loader('s2sdk_manifests_' + name,
    importlib.machinery.SourceFileLoader('s2sdk_manifests_' + name, path))
  module = importlib.util.module_from_spec(spec)
  # No __pycache__ next to the scripts, in a checkout that may be read-only
  dont_write_bytecode = sys.dont_write_bytecode
  sys.dont_write_bytecode = True
  try:
    spec.loader.exec_module(module)
  finally:
    sys.dont_write_bytecode = dont_write_bytecode
  return module

Shared = Load('shared')
Protobufs = Load('protobufs')
Platforms = {
  'linux': Load('linux'),
  'windows': Load('windows'),
}

class SdkTarget(object):
  def __init__(self, context, sdk, cxx):
    self.sdk = sdk
    self.cxx = cxx
    self.protoc = Protobufs.DetectProtoc(context, sdk, Shared.INCLUDE_PATHS)

class SdkHelpers(object):
  def __init__(self):
    self.sdks = {}
    self.sdk_manifests = []
    self.sdk_filter = None
    self.find_sdk_path = SdkHelpers.findSdkPathFromEnv
    self.sdk_targets = []

  # The default find_sdk_path: the first of the manifest's env_vars that is set
  @staticmethod
  def findSdkPathFromEnv(sdk_name):
    for name, sdk in SdkHelpers.getSdks(None):
      if name == sdk_name:
        for var in sdk['env_vars']:
          if os.environ.get(var):
            return os.environ[var]
    return None

  def findSdks(self, builder, cxx_list, sdk_list):
    not_found = []
    sdk_remaining = set(sdk_list)
    for sdk_name, sdk in SdkHelpers.getSdks(builder):
      self.sdk_manifests.append(sdk)
      # Skip SDKs that weren't specified, aren't supported, or won't build on any target
      if not self.shouldFindSdk(sdk, sdk_list) or not any(SdkHelpers.shouldBuildSdk(sdk, cxx) for cxx in cxx_list):
        continue

      sdk_path = self.find_sdk_path(sdk_name)
      if sdk_path is None:
        if 'present' not in sdk_list:
          raise Exception('Could not find a valid path for {0}'.format(sdk_name))
        not_found.append(sdk_name)
        continue

      sdk_remaining.discard(sdk_name)
      sdk['path'] = sdk_path
      self.sdks[sdk_name] = sdk

      for cxx in cxx_list:
        if SdkHelpers.shouldBuildSdk(sdk, cxx):
          self.sdk_targets += [SdkTarget(builder, sdk, cxx)]

    for sdk in not_found:
      print('Warning: s2sdk {} was not found, and will not be included in build.'.format(sdk))
    sdk_remaining -= {'all', 'present'}
    if sdk_remaining:
      raise Exception('Missing s2sdks: {}'.format(','.join(sorted(sdk_remaining))))
    if not self.sdk_targets and sdk_list:
      raise Exception('No buildable SDKs were found, nothing to build.')

  def shouldFindSdk(self, sdk, sdk_list):
    if self.sdk_filter and not self.sdk_filter(sdk):
      return False
    return 'all' in sdk_list or 'present' in sdk_list or sdk['name'] in sdk_list

  @staticmethod
  def shouldBuildSdk(sdk, cxx):
    return cxx.target.arch in sdk['platforms'].get(cxx.target.platform, [])

  @staticmethod
  def getSdks(builder):
    out = []
    folder = os.path.join(ROOT, 'manifests')
    for file in sorted(os.listdir(folder)):
      path = os.path.join(folder, file)
      with open(path, 'rt') as fp:
        sdk = json.load(fp)
      if builder is not None:
        builder.AddConfigureFile(path)
      out.append((os.path.splitext(file)[0], sdk))
    return out

  # What the binary needs from the SDK: shared.ambuild, then the platform's file
  @staticmethod
  def configureCxx(context, binary, sdk):
    Shared.ConfigureCxx(context, binary, sdk)
    Platforms[binary.compiler.target.platform].ConfigureCxx(context, binary, sdk)

  # The protos the binary uses, generated and compiled with it (protobufs.ambuild)
  @staticmethod
  def addProtobufs(context, binary, sdk_target, protos):
    Protobufs.AddProtobufs(context, binary, sdk_target, protos)

rvalue = SdkHelpers()
